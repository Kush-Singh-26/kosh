# 1. Ignore the generated site
# We do NOT want to commit the build output to the main branch.
# The GitHub Action will generate this on the fly.
public/

# 2. Build Cache Directory
# Cache files for incremental builds (not deployed to production)
.kosh-cache/
.ruff_cache/
.gocache/
perf-results/

# Build artifacts in builder/run/
builder/run/.kosh-cache/
builder/run/.kosh-artifacts/
builder/run/public/
builder/run/public.bak-*/
builder/run/public.tmp-*/

# 3. Mac OS System Files
.DS_Store

# 4. Windows System Files
Thumbs.db
ehthumbs.db
Desktop.ini

# 5. Go Build Binaries
# If you run 'go build', it creates binaries. We don't want those.
*.exe
*.exe~
*.dll
*.so
*.dylib
test
bin/
main  # In case you name your binary 'main'
tmp/
kosh

# 6. Editor/IDE Configs
.vscode/
.idea/
*.swp
*.swo

# 7. Go Modules (Optional)
# Usually you commit go.sum, but if you have a vendor folder you might ignore it
# vendor/

ant.md
*.prof
*.tmp
*.bak
*.timings.json

nul

themes/
.opencode/
*.out
*.db

# Desloppify local state
.desloppify/

# Generated WASM files (embedded at build time)
static/wasm/search.wasm
static/wasm/search.wasm.br
static/wasm/search.wasm.gz
builder/benchmarks/public/
builder/run/public/static/

# Test database files
builder/cache/test_migrations_*.db

# Build output directories
builder/benchmarks/.kosh-cache/
builder/benchmarks/public/