{{ define "content" }}
<article class="post">
    <header class="post-header">
        <h1>{{ .Title }}</h1>
        {{ if .ReadingTime }}
        <div class="post-meta">
            {{ .ReadingTime }} min read
        </div>
        {{ end }}
    </header>

    <div class="post-content">
        {{ .Content }}
    </div>
</article>
{{ end }}
